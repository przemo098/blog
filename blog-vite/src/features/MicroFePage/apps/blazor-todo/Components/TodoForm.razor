@namespace BlazorTodo.Components

<div style="display: flex; gap: 8px; margin-bottom: 12px;">
    <input
        data-testid="blazor-todo-input"
        type="text"
        @bind="text"
        @bind:event="oninput"
        @onkeydown="HandleKeyDown"
        placeholder="Add todo..."
        style="flex: 1; padding: 6px 12px; border: 1px solid #cbd5e1; border-radius: 4px; font-size: 14px; outline: none;"
    />
    <button
        @onclick="Submit"
        style="padding: 6px 12px; border: none; border-radius: 4px; font-size: 14px; cursor: pointer; background: #2563eb; color: white;"
    >
        Add
    </button>
</div>

@code {
    private string text = "";

    [Parameter]
    public EventCallback<string> OnAdd { get; set; }

    private async Task Submit()
    {
        var trimmed = text.Trim();
        if (string.IsNullOrEmpty(trimmed)) return;
        await OnAdd.InvokeAsync(trimmed);
        text = "";
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Submit();
    }
}
